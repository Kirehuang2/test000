# ============================================================
# .gitignore for e2 studio motor driver project (RA6T2)
# ============================================================

# --- Build artifacts (regenerated on build) ---
Debug/
Release/
*.elf
*.elf.in
*.map
*.rpd
*.sbd
*.srec
*.o
*.o.in
*.obj
*.d
*.lst
*.hex
*.bin

# --- IDE / project settings (personal paths possible) ---
.metadata/
.settings/
.cproject.bak
.project.bak
*.launch
*.bak

# --- OS junk ---
Thumbs.db
.DS_Store
desktop.ini

# --- Auto-generated PDFs from Markdown ---
# (Source MD is tracked; PDFs are regenerated by markdown preview tools)
doc/PWM18kHz化手順書.pdf
doc/Simulinkモデル化手順書.pdf
doc/フェールセーフブレーキ設計書.pdf
doc/ソフト管理表.pdf
doc/モーター設計書.pdf
doc/使い方ガイド.pdf
doc/基板管理表.pdf
doc/ソフトウェア設計書.pdf
doc/既存実装分析.pdf
doc/自作モータードライバ基板_仕様書.pdf
doc/設計書_1軸サーボバランサ制御システム.pdf

# --- Third-party datasheets (copyright, do not redistribute) ---
doc/drv8302.pdf
doc/r01uh0951jj0150-ra6t2.pdf
doc/REN_DA14531MOD_Datasheet*.pdf

# --- Test data / measurement logs (large, regenerable) ---
matlab/motor_log_*.csv
matlab/*.mat

# --- Python / analysis cache ---
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- MATLAB ---
*.asv
*.autosave
slprj/
sccprj/

# --- Misc ---
*.tmp
*.swp
*~
